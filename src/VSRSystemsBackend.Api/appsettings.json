{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Railway": {
    "Enabled": false,
    "InspectionEnabled": false,
    "MaintenanceEnabled": false,
    "CrowdEnabled": false,
    "LiveAdaptersEnabled": false,
    "AiEnabled": false,
    "OutboxBatchSize": 50,
    "OutboxPollSeconds": 5,
    "CrowdStaleSeconds": 300,
    "OfflinePackMaxAgeHours": 72,
    "MaxEvidenceBytes": 26214400,
    "AllowedEvidenceTypes": ["image/jpeg", "image/png", "application/pdf"]
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "vsr_systems"
  },
  "Geoapify": {
    "BaseUrl": "https://api.geoapify.com/",
    "ApiKey": "",
    "CacheHours": 24,
    "MaxResults": 6,
    "DailyProviderCallLimit": 2700,
    "UsageWarningCalls": 2400,
    "RequestsPerSecond": 5,
    "CountryBias": "in"
  },
  "Weather": {
    "BaseUrl": "https://api.open-meteo.com/",
    "CacheMinutes": 15,
    "ForecastDays": 7
  },
  "AI": {
    "TimeoutSeconds": 20,
    "SystemPrompt": "You are a concise, helpful assistant for VSR Systems users.",
    "Providers": [
      {
        "Name": "DeepSeek",
        "Endpoint": "https://api.deepseek.com/chat/completions",
        "ApiKey": "",
        "Model": "deepseek-chat"
      },
      {
        "Name": "OpenRouter",
        "Endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "ApiKey": "",
        "Model": "deepseek/deepseek-chat"
      }
    ]
  },
  "SupabaseStorage": {
    "Url": "",
    "ServiceRoleKey": "",
    "AllowedBuckets": ["uploads", "project-media"],
    "AllowedContentTypes": [
      "image/jpeg",
      "image/gif",
      "image/png",
      "image/webp",
      "application/pdf",
      "text/plain",
      "text/csv",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/zip"
    ],
    "MaxPathLength": 512,
    "SignedDownloadSeconds": 3600
  },
  "UploadNotifications": {
    "ResendApiKey": "",
    "FromEmail": "VSR Systems <onboarding@resend.dev>",
    "RecipientEmail": ""
  },
  "FeatureFlags": {
    "Enabled": true,
    "ModuleVisibility": true,
    "Branding": true,
    "Currency": true,
    "Timezone": true
  },
  "Settings": {
    "BrandingName": "VSR Systems",
    "Currency": "USD",
    "Timezone": "UTC",
    "FeatureFlagsEnabled": true
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "VSRSystemsBackend"
    }
  }
}
